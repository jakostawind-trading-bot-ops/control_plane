+				t.Fatal("неожиданная привязка")
+			}
+		case <-time.After(subscriberTestTimeout):
+			t.Fatal("подписка не появилась")
+		}
+		if want == first {
+			if err := first.Unsubscribe(); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+}
